    // 3. HIGHLIGHT SQL SYNTAX HELPER
    function highlightSQL(sql) {
      let escaped = sql
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');

      return escaped.split('\n').map((line, idx) => {
        if (line.trim().startsWith('--')) {
          return `<span class="ln">${idx + 1}</span><span class="cm">${line}</span>`;
        }
        // Highlight strings first using placeholders
        const strings = [];
        let processed = line.replace(/'([^']*)'/g, (match) => {
          strings.push(match);
          return `___STR_${strings.length - 1}___`;
        });

        // Keywords
        processed = processed.replace(/\b(SELECT|FROM|WHERE|AND|OR|XOR|NOT|BETWEEN|LIKE|REGEXP|ORDER|BY|ASC|DESC|AS|UPDATE|SET|CASE|WHEN|THEN|ELSE|END|IS|NULL|UNSIGNED|SIGNED|INTEGER|INTERVAL)\b/g, '<span class="kw">$1</span>');
        // Functions
        processed = processed.replace(/\b(CONCAT|CONCAT_WS|LOWER|LCASE|UPPER|LEFT|RIGHT|MID|SUBSTR|SUBSTRING_INDEX|TRIM|LTRIM|RTRIM|REPLACE|LOCATE|POSITION|LPAD|RPAD|CHAR_LENGTH|PI|POWER|SQRT|ROUND|TRUNCATE|CEILING|FLOOR|SIN|COS|TAN|RADIANS|DEGREES|YEAR|MONTH|DAY|MONTHNAME|DAYNAME|NOW|CURDATE|CURRENT_DATE|DATE_FORMAT|WEEKDAY|DAYOFWEEK|TIMESTAMPDIFF|DATEDIFF|EXTRACT|MAX|MIN|CONVERT|CAST|IF|IFNULL|NULLIF|COALESCE)\b/g, '<span class="fn">$1</span>');
        // Numbers
        processed = processed.replace(/\b(\d+(\.\d+)?)\b/g, '<span class="nm">$1</span>');

        // Restore strings
        processed = processed.replace(/___STR_(\d+)___/g, (_, i) => `<span class="st">${strings[Number(i)]}</span>`);

        return `<span class="ln">${idx + 1}</span>${processed}`;
      }).join('\n');
    }

    // 4. RENDER TABLE FROM OBJECT ARRAY
    function renderResultTable(rows) {
      if (!rows || rows.length === 0) {
        return `<div class="p-4 text-xs font-mono text-amber-300 bg-slate-900/60 rounded-xl border border-slate-800">Empty set (0 rows returned)</div>`;
      }
      const cols = Object.keys(rows[0]);
      let html = `
        <div class="overflow-x-auto rounded-xl border border-slate-700/80">
          <table class="w-full text-left text-xs border-collapse font-mono">
            <thead class="bg-slate-900 text-cyan-300 border-b border-slate-700">
              <tr>
                <th class="p-2.5 w-10 text-center text-slate-500">#</th>
                ${cols.map(c => `<th class="p-2.5">${c}</th>`).join('')}
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800 bg-slate-950/60 text-slate-200">
              ${rows.map((r, i) => `
                <tr class="hover:bg-slate-800/60 transition-colors">
                  <td class="p-2.5 text-center text-slate-500">${i + 1}</td>
                  ${cols.map(c => {
                    const val = r[c];
                    if (val === null) return `<td class="p-2.5 text-rose-400 italic">NULL</td>`;
                    return `<td class="p-2.5">${val}</td>`;
                  }).join('')}
                </tr>
              `).join('')}
            </tbody>
          </table>
        </div>
      `;
