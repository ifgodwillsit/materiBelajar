    const DAYS_EN = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
    const DAYS_SHORT = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    const MONTHS_EN = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
    const MONTHS_SHORT = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

    function parseDateParts(dateStr) {
      const [y, m, d] = dateStr.split('-').map(Number);
      const dt = new Date(y, m - 1, d);
      return {
        year: y,
        month: m,
        day: d,
        jsDay: dt.getDay(), // 0=Sun..6=Sat
        mysqlWeekday: (dt.getDay() + 6) % 7, // 0=Mon..6=Sun
        dayName: DAYS_EN[dt.getDay()],
        dayShort: DAYS_SHORT[dt.getDay()],
        monthName: MONTHS_EN[m - 1],
        monthShort: MONTHS_SHORT[m - 1]
      };
    }

    function formatMySQLDate(dateStr, formatStr) {
      const p = parseDateParts(dateStr);
      const ordinal = (n) => {
        if (n > 3 && n < 21) return n + 'th';
        switch (n % 10) {
          case 1: return n + 'st';
          case 2: return n + 'nd';
          case 3: return n + 'rd';
          default: return n + 'th';
        }
      };
      return formatStr
        .replace(/%W/g, p.dayName)
        .replace(/%a/g, p.dayShort)
        .replace(/%M/g, p.monthName)
        .replace(/%b/g, p.monthShort)
        .replace(/%Y/g, String(p.year))
        .replace(/%y/g, String(p.year).slice(-2))
        .replace(/%m/g, String(p.month).padStart(2, '0'))
        .replace(/%c/g, String(p.month))
        .replace(/%d/g, String(p.day).padStart(2, '0'))
        .replace(/%e/g, String(p.day))
        .replace(/%D/g, ordinal(p.day))
        .replace(/%w/g, String(p.jsDay))
        .replace(/%H/g, '00')
        .replace(/%i/g, '00')
        .replace(/%s/g, '00');
    }

    function calculateAge(dateStr) {
      // Gunakan tanggal referensi 2026-10-29
      const refY = 2026, refM = 10, refD = 29;
      const [y, m, d] = dateStr.split('-').map(Number);
      let age = refY - y;
      if (refM < m || (refM === m && refD < d)) {
        age--;
      }
      return age;
    }

