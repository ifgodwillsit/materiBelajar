        btn.className = 'nav-btn w-full flex items-center justify-between px-3 py-2.5 rounded-xl font-medium text-left transition-all text-slate-300 hover:bg-slate-700/50';
      });
      const activeBtn = document.getElementById(`btn-${tabId}`);
      if (activeBtn) {
        activeBtn.className = 'nav-btn w-full flex items-center justify-between px-3 py-2.5 rounded-xl font-medium text-left transition-all bg-cyan-500/15 text-cyan-300 border border-cyan-500/30';
      }
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function copyRawString(text) {
      const ta = document.createElement('textarea');
      ta.value = text;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
      showToast('Query SQL berhasil disalin ke clipboard!');
    }

    function copyTextById(id, isInput = false) {
      const el = document.getElementById(id);
      if (!el) return;
      const text = isInput ? el.value : el.textContent;
      copyRawString(text);
    }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      document.getElementById('toast-msg').textContent = msg;
      toast.classList.remove('translate-y-24', 'opacity-0');
      setTimeout(() => {
        toast.classList.add('translate-y-24', 'opacity-0');
      }, 2600);
    }

    // INITIALIZE EVERYTHING ON LOAD
    window.addEventListener('DOMContentLoaded', () => {
      renderPhpMyAdmin();
      renderAllExerciseSections();
      updateStringSandbox();
      updateNumericSandbox();
      updateDateFormatSandbox();
      initPlayground();
      renderQuiz();
    });
  </script>
</body>
</html>
