    function generateSQLDumpString() {
      const values = INITIAL_MAHASISWA.map(r => {
        const telp = r.no_telp === null ? 'NULL' : `'${r.no_telp}'`;
        return `('${r.nim}', '${r.nama_depan}', '${r.nama_belakang}', '${r.alamat}', ${r.ipk.toFixed(2)}, ${r.ips.toFixed(2)}, ${r.sks}, '${r.tgl_lahir}', ${telp}, '${r.email}', '${r.sex}')`;
      }).join(',\n');

      return `-- ====================================================================
-- DUMP SQL PRAKTIKUM SISTEM BASIS DATA - MODUL 10: OPERATOR & FUNGSI SQL
-- Database: PERT_07 | Tabel: mahasiswa
-- ====================================================================

CREATE DATABASE IF NOT EXISTS PERT_07;
USE PERT_07;

DROP TABLE IF EXISTS mahasiswa;

CREATE TABLE mahasiswa (
  nim varchar(8) NOT NULL,
  nama_depan varchar(50) NOT NULL,
  nama_belakang varchar(50) NOT NULL,
  alamat varchar(150) NOT NULL,
  ipk float(3,2) NOT NULL,
  ips float(3,2) NOT NULL,
  sks int(3) NOT NULL,
  tgl_lahir date NOT NULL,
  no_telp varchar(15) DEFAULT NULL,
  email varchar(50) NOT NULL,
  sex enum('M','F') NOT NULL,
  PRIMARY KEY (nim)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

INSERT INTO mahasiswa (nim, nama_depan, nama_belakang, alamat, ipk, ips, sks, tgl_lahir, no_telp, email, sex) VALUES
${values};`;
    }

    function downloadMahasiswaSQL() {
      const sqlContent = generateSQLDumpString();
      const blob = new Blob([sqlContent], { type: 'application/sql;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'mahasiswa.sql';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showToast('File mahasiswa.sql berhasil diunduh!');
    }

