    // 7. SANDBOX UPDATERS (STRING, NUMERIC, DATE_FORMAT)
    function updateStringSandbox() {
      const str = document.getElementById('str-sb-input').value;
      const pos = Math.max(1, parseInt(document.getElementById('str-sb-pos').value) || 1);
      const len = Math.max(1, parseInt(document.getElementById('str-sb-len').value) || 1);

      const left2 = str.slice(0, 2);
      const midVal = str.slice(pos - 1, pos - 1 + len);
      const kabKota = extractKabupatenKota(str);
      const replaced = str.replace(/gmail/gi, 'ukdw');

      const items = [
        { expr: `CHAR_LENGTH('${str.slice(0,18)}...')`, val: str.length },
        { expr: `LEFT(str, 2)`, val: `'${left2}'` },
        { expr: `MID(str, ${pos}, ${len})`, val: `'${midVal}'` },
        { expr: `LOWER(str)`, val: `'${str.toLowerCase().slice(0, 24)}'` },
        { expr: `REPLACE(str, 'gmail', 'ukdw')`, val: `'${replaced.slice(0, 26)}'` },
        { expr: `SUBSTRING_INDEX(SUBSTRING_INDEX(str,',',2),',',-1)`, val: `'${kabKota}'` }
      ];

      document.getElementById('str-sb-results').innerHTML = items.map(it => `
        <div class="p-2.5 rounded-xl bg-slate-800/90 border border-slate-700/80">
          <div class="text-[10px] text-purple-300 truncate">${it.expr}</div>
          <div class="text-xs font-bold text-emerald-300 mt-1 truncate">${it.val}</div>
        </div>
      `).join('');
    }

    function updateNumericSandbox() {
      const r = parseFloat(document.getElementById('num-sb-r').value) || 5;
      const deg = parseFloat(document.getElementById('num-sb-deg').value) || 120;

      document.getElementById('num-sb-r-val').textContent = `${r} cm`;
      document.getElementById('num-sb-deg-val').textContent = `${deg}°`;

      const area = (Math.PI * Math.pow(r, 2)).toFixed(2);
      document.getElementById('num-sb-circle-sql').innerHTML = `
        <div><span class="kw">SELECT</span> <span class="fn">CONCAT</span>(<span class="fn">ROUND</span>(<span class="fn">PI</span>() * <span class="fn">POWER</span>(${r}, 2), 2), <span class="st">' cm'</span>);</div>
        <div class="mt-1 text-emerald-400 font-bold">&rarr; Hasil: '${area} cm'</div>
      `;

      const rad = (deg * Math.PI) / 180;
      const sinVal = Math.sin(rad).toFixed(4);
      const cosVal = Math.cos(rad).toFixed(4);
      document.getElementById('num-sb-trig-sql').innerHTML = `
        <div><span class="kw">SELECT</span> <span class="fn">SIN</span>(<span class="fn">RADIANS</span>(${deg})), <span class="fn">COS</span>(<span class="fn">RADIANS</span>(${deg}));</div>
        <div class="mt-1 text-cyan-300 font-bold">&rarr; SIN = ${sinVal} | COS = ${cosVal}</div>
      `;
    }

